#!/usr/bin/env bash

device_name="Keychron K3"

find_connected_device() {
    local type address name

    while read -r type address name; do
        if [[ $type == "Device" && $name == "$device_name" ]]; then
            printf '%s\n' "$address"
            return 0
        fi
    done < <(bluetoothctl devices Connected 2>/dev/null)

    return 1
}

device_address=$(find_connected_device) || exit 1

if [[ $1 == "--connected" ]]; then
    exit 0
fi

device_info=$(bluetoothctl info "$device_address" 2>/dev/null) || exit 1
while IFS= read -r line; do
    if [[ $line =~ Battery[[:space:]]Percentage:.*\(([0-9]+)\) ]]; then
        percentage=${BASH_REMATCH[1]}
        break
    fi
done <<< "$device_info"
[[ -n $percentage ]] || exit 1

if ((percentage <= 15)); then
    class="critical"
elif ((percentage <= 30)); then
    class="warning"
else
    class="good"
fi

printf '{"text":"  %d%%","tooltip":"Keychron K3 battery: %d%%","class":"%s","percentage":%d}\n' \
    "$percentage" "$percentage" "$class" "$percentage"
