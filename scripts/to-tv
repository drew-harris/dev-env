#!/bin/bash

# Resolve connector names by monitor model. Connector numbering shifts when
# the eGPU dock is attached (the Dell moved DP-1 -> DP-2), so never hardcode.
outputs=$(niri msg -j outputs)
PC=$(echo "$outputs" | jq -r 'to_entries[] | select(.value.model == "DELL S2725QS") | .key')
TV=$(echo "$outputs" | jq -r 'to_entries[] | select(.value.model == "TCL") | .key')

if [[ -z "$TV" ]]; then
  echo "to-tv: TV not found" >&2
  exit 1
fi

niri msg output "$TV" on
niri msg output "$TV" mode 1920x1080@60.00
niri msg output "$TV" scale 1.4

[[ -n "$PC" ]] && niri msg output "$PC" off

$HOME/programs/home/activate-computer.nu
